* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf whitespace=-trailing-space
*.json text eol=lf
*.csv text eol=lf

# Third-party archival source is preserved byte-for-byte; do not apply the
# repository's whitespace policy to the vendored SAVE package snapshot.
datasets/case_b_spotweld/legacy/_raw/SAVE/** -whitespace

*.gz binary
*.pdf binary
*.png binary
*.rda binary

# Dataset metadata records byte-level SHA-256 values. Preserve original CSV
# line endings so a fresh checkout passes the same data acceptance checks.
migration/datasets/**/*.csv -text whitespace=cr-at-eol

*.pptx binary
*.docx binary
